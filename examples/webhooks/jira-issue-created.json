          },
          {
            "type": "bulletList",
            "content": [
              {
                "type": "listItem",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Add "
                      },
                      {
                        "type": "text",
                        "text": "Order.split_evenly()",
                        "marks": [
                          {
                            "type": "code"
                          }
                        ]
                      },
                      {
                        "type": "text",
                        "text": ", which returns each person's equal share of the total."
                      }
                    ]
                  }
                ]
              },
              {
                "type": "listItem",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
