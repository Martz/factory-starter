@@ -1,8 +1,10 @@
+import contextlib
+import io
 import tempfile
 import unittest
 from pathlib import Path
 
-from lunchbox.cli import load, render
+from lunchbox.cli import RowError, load, main, render
 
 CSV = """person,item,price,tags
 Ada,Falafel wrap,7.50,vegan
@@ -23,5 +25,63 @@ class CliTest(unittest.TestCase):
         self.assertTrue(out.strip().endswith("19.65"))
 
 
+HEADER = "person,item,price,tags\n"
+
+
+def run_cli(text):
+    out, err = io.StringIO(), io.StringIO()
+    with tempfile.TemporaryDirectory() as d:
+        path = Path(d) / "order.csv"
+        path.write_text(text)
+        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
+            code = main([str(path)])
+    return code, out.getvalue(), err.getvalue()
+
+
+class CliErrorTest(unittest.TestCase):
+    def test_bad_prices_report_line_on_stderr_and_exit_2(self):
+        for price in ["-4.50", "0", "0.00", "abc", ""]:
+            with self.subTest(price=price):
+                text = HEADER + "Ada,Wrap,7.50,\nGrace,Tea,2.00,\nLinus,Coffee," + price + ",\n"
+                code, out, err = run_cli(text)
+                self.assertEqual(code, 2)
+                self.assertEqual(out, "")
+                self.assertTrue(err.startswith("error: line 4: "))
+                self.assertEqual(err.count("\n"), 1)
+                self.assertIn("Linus", err)
+                self.assertIn("Coffee", err)
+                self.assertNotIn("Traceback", err)
+
+    def test_line_number_accounts_for_blank_lines(self):
+        code, out, err = run_cli(HEADER + "Ada,Wrap,7.50,\n\n\nGrace,Tea,-1,\n")
+        self.assertEqual((code, out), (2, ""))
+        self.assertTrue(err.startswith("error: line 5: "))
+
+    def test_line_number_accounts_for_multiline_quoted_field(self):
+        code, out, err = run_cli(HEADER + 'Ada,"Wrap\nwith extra",7.50,\nGrace,Tea,-1,\n')
+        self.assertEqual((code, out), (2, ""))
+        self.assertTrue(err.startswith("error: line 4: "))
+
+    def test_load_surfaces_line_number(self):
+        with tempfile.TemporaryDirectory() as d:
+            path = Path(d) / "order.csv"
+            path.write_text(HEADER + "Ada,Wrap,x,\n")
+            with self.assertRaises(RowError) as cm:
+                load(path)
+        self.assertEqual(cm.exception.line, 2)
+
+    def test_missing_columns_do_not_traceback(self):
+        code, out, err = run_cli(HEADER + "Ada,Wrap\n")
+        self.assertEqual((code, out), (2, ""))
+        self.assertTrue(err.startswith("error: line 2: "))
+
+    def test_valid_csv_prints_table_and_exits_0(self):
+        code, out, err = run_cli(CSV)
+        self.assertEqual(code, 0)
+        self.assertEqual(err, "")
+        self.assertTrue(out.rstrip().splitlines()[-1].startswith("TOTAL"))
+        self.assertTrue(out.rstrip().endswith("19.65"))
+
+
 if __name__ == "__main__":
     unittest.main()
