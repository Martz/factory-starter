+from decimal import Decimal, InvalidOperation, ROUND_HALF_UP
 
 PENNY = Decimal("0.01")
 
@@ -12,6 +12,20 @@ def money(value: Decimal | str | int | float) -> Decimal:
     return Decimal(str(value)).quantize(PENNY, rounding=ROUND_HALF_UP)
 
 
+def _valid_price(person: str, name: str, price: Decimal | str | int | float) -> Decimal:
+    reason = "must be a number greater than zero"
+    try:
+        amount = Decimal(str(price).strip())
+        if not amount.is_finite():
+            raise ValueError(reason)
+        rounded = money(amount)
+    except (InvalidOperation, ValueError):
+        raise ValueError(f"invalid price {price!r} for {person}'s {name}: {reason}") from None
+    if rounded <= 0:
+        raise ValueError(f"invalid price {price!r} for {person}'s {name}: {reason}")
+    return rounded
+
+
 @dataclass(frozen=True)
 class Item:
     person: str
