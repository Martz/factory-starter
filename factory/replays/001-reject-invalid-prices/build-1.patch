+class PriceValidationTest(unittest.TestCase):
+    def setUp(self):
+        self.order = Order()
+
+    def assert_rejected(self, price):
+        with self.assertRaises(ValueError) as cm:
+            self.order.add("Ada", "Lemonade", price)
+        self.assertNotIsInstance(cm.exception, InvalidOperation)
+        self.assertIn("Ada", str(cm.exception))
+        self.assertIn("Lemonade", str(cm.exception))
+        self.assertEqual(self.order.items, [])
+
+    def test_rejects_negative_zero_and_non_numeric(self):
+        for price in ["-4.50", "0", "0.00", "abc", "", "NaN", "Infinity", "-Infinity"]:
+            with self.subTest(price=price):
+                self.assert_rejected(price)
+
+    def test_rejects_price_that_rounds_to_zero(self):
+        self.assert_rejected("0.004")
+
+    def test_rejects_non_finite_floats_and_decimals(self):
+        for price in [float("nan"), float("inf"), -float("inf"), Decimal("NaN"), Decimal("Infinity")]:
+            with self.subTest(price=price):
+                self.assert_rejected(price)
+
+    def test_rejects_negative_numbers_of_other_types(self):
+        for price in [-4.5, -1, Decimal("-0.01")]:
+            with self.subTest(price=price):
+                self.assert_rejected(price)
+
+    def test_accepts_valid_prices_rounded_half_up(self):
+        for price, expected in [("0.01", "0.01"), ("7.50", "7.50"), ("2.345", "2.35"), (3, "3.00")]:
+            with self.subTest(price=price):
+                self.assertEqual(self.order.add("Ada", "Lemonade", price).price, Decimal(expected))
+
+    def test_rejected_item_does_not_change_totals(self):
+        self.order.add("Ada", "Wrap", "7.50")
+        with self.assertRaises(ValueError):
+            self.order.add("Grace", "Tea", "-1")
+        self.assertEqual(self.order.total(), Decimal("7.50"))
+        self.assertEqual(self.order.per_person(), {"Ada": Decimal("7.50")})
+
+
+
+
 if __name__ == "__main__":
     unittest.main()
