@@ -20,9 +20,24 @@ class Item:
     tags: frozenset[str] = frozenset()
 
 
+def parse_percent(value: Decimal | str | int | float) -> Decimal:
+    """Parse a non-negative, finite percentage as Decimal or raise ValueError."""
+    try:
+        pct = Decimal(str(value).strip())
+    except ArithmeticError:
+        raise ValueError(f"invalid percentage: {value!r}") from None
+    if not pct.is_finite() or pct < 0:
+        raise ValueError(f"percentage must be a finite number >= 0: {value!r}")
+    return pct
+
+
 @dataclass
 class Order:
     items: list[Item] = field(default_factory=list)
+    service: Decimal = Decimal("0")
+
+    def __post_init__(self) -> None:
+        self.service = parse_percent(self.service)
 
     def add(self, person: str, name: str, price: Decimal | str, tags: tuple[str, ...] = ()) -> Item:
         item = Item(person=person.strip(), name=name.strip(), price=money(price), tags=frozenset(t.strip().lower() for t in tags if t.strip()))
@@ -35,12 +50,32 @@ class Order:
     def subtotal(self) -> Decimal:
         return sum((i.price for i in self.items), Decimal("0.00"))
 
+    def service_charge(self) -> Decimal:
+        return money(self.subtotal() * parse_percent(self.service) / 100)
+
     def total(self) -> Decimal:
-        return self.subtotal()
+        return self.subtotal() + self.service_charge()
 
     def per_person(self) -> dict[str, Decimal]:
-        """Each person pays for their own items."""
+        """Each person pays for their own items plus a proportional share of the service charge.
+
+        Pennies of the charge are allocated by largest remainder (ties: sorted name),
+        so the amounts always add up exactly to total().
+        """
         owed = {p: Decimal("0.00") for p in self.people()}
         for i in self.items:
             owed[i.person] += i.price
-        return owed
+        charge = self.service_charge()
+        subtotal = self.subtotal()
+        if charge == 0 or subtotal == 0:
+            return owed
+
+        charge_pennies = int(charge / PENNY)
+        base_pennies = {p: int(a / PENNY) for p, a in owed.items()}
+        sub_pennies = sum(base_pennies.values())
+        shares = {p: (charge_pennies * b) // sub_pennies for p, b in base_pennies.items()}
+        remainders = {p: (charge_pennies * b) % sub_pennies for p, b in base_pennies.items()}
+        leftover = charge_pennies - sum(shares.values())
+        for p in sorted(owed, key=lambda p: (-remainders[p], p))[:leftover]:
+            shares[p] += 1
+        return {p: owed[p] + Decimal(shares[p]) * PENNY for p in owed}
