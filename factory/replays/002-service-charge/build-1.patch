+from lunchbox.cli import load, main, render
 
 CSV = """person,item,price,tags
 Ada,Falafel wrap,7.50,vegan
@@ -22,6 +24,54 @@ class CliTest(unittest.TestCase):
         self.assertIn("TOTAL", out)
         self.assertTrue(out.strip().endswith("19.65"))
 
+    def run_cli(self, *args):
+        out, err = io.StringIO(), io.StringIO()
+        with tempfile.TemporaryDirectory() as d:
+            path = Path(d) / "order.csv"
+            path.write_text(CSV)
+            argv = [a.replace("FILE", str(path)) for a in args]
+            with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
+                try:
+                    code = main(argv)
+                except SystemExit as e:
+                    code = e.code
+        return code, out.getvalue(), err.getvalue()
+
+    def test_no_service_output_is_unchanged(self):
+        code, out, _ = self.run_cli("FILE")
+        self.assertEqual(code, 0)
+        self.assertEqual(out.splitlines(), [
+            "person          owes",
+            "Ada             9.70",
+            "Grace           9.95",
+            "TOTAL          19.65",
+        ])
+
+    def test_service_flag_shares_charge_and_totals(self):
+        for args in (("FILE", "--service", "12.5"), ("--service", "12.5", "FILE")):
+            with self.subTest(args=args):
+                code, out, _ = self.run_cli(*args)
+                self.assertEqual(code, 0)
+                self.assertEqual(out.splitlines(), [
+                    "person          owes",
+                    "Ada            10.91",
+                    "Grace          11.20",
+                    "TOTAL          22.11",
+                ])
+
+    def test_service_zero_is_accepted(self):
+        code, out, _ = self.run_cli("FILE", "--service", "0")
+        self.assertEqual(code, 0)
+        self.assertTrue(out.strip().endswith("19.65"))
+
+    def test_invalid_service_is_rejected_on_stderr(self):
+        for bad in ("-5", "abc", "nan", "inf"):
+            with self.subTest(bad=bad):
+                code, out, err = self.run_cli("FILE", "--service", bad)
+                self.assertNotEqual(code, 0)
+                self.assertEqual(out, "")
+                self.assertIn("--service", err)
+
 
 if __name__ == "__main__":
     unittest.main()
diff --git a/tests/test_orders.py b/tests/test_orders.py
index 2c55573..59ac0fb 100644
--- a/tests/test_orders.py
+++ b/tests/test_orders.py
@@ -30,5 +30,61 @@ class OrderTest(unittest.TestCase):
         self.assertEqual(self.order.people(), ["Ada", "Grace"])
 
 
+class ServiceChargeTest(unittest.TestCase):
+    def setUp(self):
+        self.order = Order(service="12.5")
+        self.order.add("Ada", "Falafel wrap", "7.50")
+        self.order.add("Grace", "Chicken katsu", "9.95")
+        self.order.add("Ada", "Lemonade", "2.20")
+
+    def test_default_service_is_zero(self):
+        order = Order()
+        self.assertEqual(order.service, Decimal("0"))
+        order.add("Ada", "Soup", "4.00")
+        self.assertEqual(order.total(), order.subtotal())
+        self.assertEqual(order.per_person(), {"Ada": Decimal("4.00")})
+
+    def test_total_includes_service_rounded_half_up(self):
+        self.assertEqual(self.order.total(), Decimal("22.11"))
+
+    def test_service_is_shared_in_proportion(self):
+        self.assertEqual(self.order.per_person(), {"Ada": Decimal("10.91"), "Grace": Decimal("11.20")})
+
+    def test_per_person_amounts_have_two_decimal_places(self):
+        for amount in self.order.per_person().values():
+            self.assertIsInstance(amount, Decimal)
+            self.assertEqual(amount.as_tuple().exponent, -2)
+
+    def test_pennies_always_add_up_exactly(self):
+        prices = ["3.33", "1.01", "7.77", "0.99", "4.51", "2.02", "9.99"]
+        for pct in ("12.5", "10", "0", "7.5", "100", "133.333"):
+            order = Order(service=pct)
+            for n, price in enumerate(prices):
+                order.add(f"P{n % 5}", "thing", price)
+            with self.subTest(pct=pct):
+                self.assertEqual(sum(order.per_person().values()), order.total())
+
+    def test_leftover_pennies_break_ties_by_name(self):
+        order = Order(service="50")
+        for name in ("Cy", "Bo", "Al"):
+            order.add(name, "thing", "0.01")
+        # charge rounds to 0.02 and the three remainders tie, so the first two names get a penny
+        self.assertEqual(
+            order.per_person(),
+            {"Al": Decimal("0.02"), "Bo": Decimal("0.02"), "Cy": Decimal("0.01")},
+        )
+
+    def test_zero_subtotal_does_not_divide_by_zero(self):
+        order = Order(service="12.5")
+        order.add("Ada", "Water", "0.00")
+        self.assertEqual(order.per_person(), {"Ada": Decimal("0.00")})
+        self.assertEqual(order.total(), Decimal("0.00"))
+
+    def test_invalid_service_raises_value_error(self):
+        for bad in ("-5", "abc", "nan", "inf", "-inf", ""):
+            with self.subTest(bad=bad), self.assertRaises(ValueError):
+                Order(service=bad)
+
+
 if __name__ == "__main__":
     unittest.main()
