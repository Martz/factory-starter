diff --git a/lunchbox/orders.py b/lunchbox/orders.py
index b0a78e8..70fec65 100644
--- a/lunchbox/orders.py
+++ b/lunchbox/orders.py
@@ -44,3 +44,12 @@ class Order:
         for i in self.items:
             owed[i.person] += i.price
         return owed
+
+    def split_evenly(self) -> dict[str, Decimal]:
+        """Equal share of the total each; leftover pennies go one each in alphabetical order."""
+        people = self.people()
+        if not people:
+            return {}
+        cents = int(self.total() / PENNY)
+        base, rem = divmod(cents, len(people))
+        return {p: (base + (1 if i < rem else 0)) * PENNY for i, p in enumerate(people)}
