+        self.assertEqual(lines, [f"{'person':<12}{'owes':>8}", f"{'TOTAL':<12}{'0.00':>8}"])
+
+    def test_render_split_evenly_total_equals_sum_of_rows(self):
+        order = Order()
+        order.add("A", "x", "10.00")
+        order.add("B", "x", "0")
+        order.add("C", "x", "0")
+        lines = render(order, split_evenly=True).splitlines()
+        rows = [Decimal(l[12:].strip()) for l in lines[1:-1]]
+        self.assertEqual(sum(rows), Decimal(lines[-1][12:].strip()))
+
 
 if __name__ == "__main__":
     unittest.main()
diff --git a/tests/test_orders.py b/tests/test_orders.py
index 2c55573..55c38af 100644
--- a/tests/test_orders.py
+++ b/tests/test_orders.py
@@ -30,5 +30,63 @@ class OrderTest(unittest.TestCase):
         self.assertEqual(self.order.people(), ["Ada", "Grace"])
 
 
+class SplitEvenlyTest(unittest.TestCase):
+    def order_of(self, *prices_by_person):
+        order = Order()
+        for person, price in prices_by_person:
+            order.add(person, "x", price)
+        return order
+
+    def test_remainder_goes_to_first_people_alphabetically(self):
+        order = self.order_of(("C", "10.00"), ("A", "0.00"), ("B", "0.00"))
+        shares = order.split_evenly()
+        self.assertEqual(shares, {"A": Decimal("3.34"), "B": Decimal("3.33"), "C": Decimal("3.33")})
+        self.assertEqual(list(shares), ["A", "B", "C"])
+        self.assertTrue(all(isinstance(v, Decimal) for v in shares.values()))
+
+    def test_two_pennies_left_over(self):
+        order = self.order_of(("C", "10.01"), ("A", "0"), ("B", "0"))
+        self.assertEqual(list(order.split_evenly().values()), [Decimal("3.34"), Decimal("3.34"), Decimal("3.33")])
+
+    def test_penny_split_three_ways(self):
+        order = self.order_of(("A", "0.01"), ("B", "0"), ("C", "0"))
+        self.assertEqual(list(order.split_evenly().values()), [Decimal("0.01"), Decimal("0.00"), Decimal("0.00")])
+
+    def test_exact_division(self):
+        order = self.order_of(("A", "10.00"), ("B", "0"), ("C", "0"), ("D", "0"))
+        self.assertEqual(order.split_evenly(), {p: Decimal("2.50") for p in "ABCD"})
+
+    def test_single_person_pays_everything(self):
+        order = self.order_of(("Ada", "4.20"), ("Ada", "1.11"))
+        self.assertEqual(order.split_evenly(), {"Ada": Decimal("5.31")})
+
+    def test_empty_order(self):
+        self.assertEqual(Order().split_evenly(), {})
+
+    def test_only_people_in_order_count_regardless_of_items(self):
+        order = self.order_of(("Ada", "1.00"), ("Ada", "1.00"), ("Ada", "1.00"), ("Bob", "1.00"))
+        self.assertEqual(order.split_evenly(), {"Ada": Decimal("2.00"), "Bob": Decimal("2.00")})
+
+    def test_friday_example(self):
+        order = Order()
+        for person, price in [("Ada", "7.50"), ("Grace", "9.95"), ("Linus", "11.40"),
+                              ("Margaret", "8.25"), ("Ada", "2.20"), ("Linus", "4.80")]:
+            order.add(person, "x", price)
+        self.assertEqual(order.total(), Decimal("44.10"))
+        self.assertEqual(order.split_evenly(), {
+            "Ada": Decimal("11.03"), "Grace": Decimal("11.03"),
+            "Linus": Decimal("11.02"), "Margaret": Decimal("11.02"),
+        })
+
+    def test_shares_always_sum_to_total(self):
+        for n in range(1, 8):
+            for cents in (0, 1, 7, 999, 1001, 4410):
+                order = Order()
+                for i in range(n):
+                    order.add(f"P{i}", "x", "0")
+                order.add("P0", "y", Decimal(cents) / 100)
+                self.assertEqual(sum(order.split_evenly().values()), order.total())
+
+
 if __name__ == "__main__":
     unittest.main()
