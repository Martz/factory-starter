+    def run_cli(self, text, *flags):
+        with tempfile.TemporaryDirectory() as d:
+            path = Path(d) / "order.csv"
+            path.write_text(text)
+            buf = io.StringIO()
+            with contextlib.redirect_stdout(buf):
+                code = main([str(path), *flags])
+        return code, buf.getvalue().splitlines()
+
