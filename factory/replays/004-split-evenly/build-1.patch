+        code, lines = self.run_cli(FRIDAY, "--split-evenly")
+        self.assertEqual(code, 0)
+        self.assertEqual(lines, [
+            f"{'person':<12}{'owes':>8}",
+            f"{'Ada':<12}{'11.03':>8}",
+            f"{'Grace':<12}{'11.03':>8}",
+            f"{'Linus':<12}{'11.02':>8}",
+            f"{'Margaret':<12}{'11.02':>8}",
+            f"{'TOTAL':<12}{'44.10':>8}",
+        ])
+
+    def test_without_flag_output_is_per_person(self):
+        code, lines = self.run_cli(FRIDAY)
+        self.assertEqual(code, 0)
+        self.assertIn(f"{'Ada':<12}{'9.70':>8}", lines)
+        self.assertEqual(lines[-1], f"{'TOTAL':<12}{'44.10':>8}")
+
+    def test_split_evenly_empty_order(self):
+        code, lines = self.run_cli("person,item,price,tags\n", "--split-evenly")
