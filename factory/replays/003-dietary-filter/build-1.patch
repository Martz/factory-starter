+def render_items(items: list[Item]) -> str:
+    pw = max([len("person"), len("TOTAL")] + [len(i.person) for i in items]) + 2
+    iw = max([len("item")] + [len(i.name) for i in items]) + 2
+    lines = [f"{'person':<{pw}}{'item':<{iw}}{'price':>8}"]
+    for i in items:
+        lines.append(f"{i.person:<{pw}}{i.name:<{iw}}{i.price:>8}")
+    total = money(sum((i.price for i in items), Decimal("0.00")))
+    lines.append(f"{'TOTAL':<{pw}}{'':<{iw}}{total:>8}")
+    return "\n".join(lines)
+
