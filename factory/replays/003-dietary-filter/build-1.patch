@@ -1,8 +1,10 @@
+import contextlib
+import io
 import tempfile
 import unittest
 from pathlib import Path
 
-from lunchbox.cli import load, render
+from lunchbox.cli import load, main, render
 
 CSV = """person,item,price,tags
 Ada,Falafel wrap,7.50,vegan
@@ -23,5 +25,92 @@ class CliTest(unittest.TestCase):
         self.assertTrue(out.strip().endswith("19.65"))
 
 
+FRIDAY = """person,item,price,tags
+Ada,Falafel wrap,7.50,vegan
+Grace,Chicken katsu,9.95,
+Linus,Ramen,11.40,
+Margaret,Halloumi salad,8.25,veggie;gf
+Ada,Lemonade,2.20,Vegan;GF
+Linus,Gyoza,4.80,
+"""
+
+
+def run_cli(csv_text, *args, name="order.csv", write=True):
+    with tempfile.TemporaryDirectory() as d:
+        path = Path(d) / name
+        if write:
+            path.write_text(csv_text)
+        out, err = io.StringIO(), io.StringIO()
+        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
+            try:
+                code = main([str(path), *args])
+            except SystemExit as e:
+                code = e.code
+    return code, out.getvalue(), err.getvalue()
+
+
+class OnlyTest(unittest.TestCase):
+    def test_only_lists_matching_items_in_order(self):
+        code, out, err = run_cli(FRIDAY, "--only", "vegan")
+        lines = out.splitlines()
+        self.assertEqual(code, 0)
+        self.assertEqual(err, "")
+        self.assertEqual(lines[0].split(), ["person", "item", "price"])
+        self.assertEqual(lines[1].split(), ["Ada", "Falafel", "wrap", "7.50"])
+        self.assertEqual(lines[2].split(), ["Ada", "Lemonade", "2.20"])
+        self.assertEqual(len(lines), 4)
+        self.assertNotIn("owes", out)
+        for name in ("Grace", "Linus", "Margaret"):
+            self.assertNotIn(name, out)
+
+    def test_only_matches_any_of_several_tags(self):
+        _, out, _ = run_cli(FRIDAY, "--only", "gf")
+        self.assertIn("Lemonade", out)
+        self.assertIn("Halloumi salad", out)
+        self.assertNotIn("Falafel", out)
+
+    def test_only_is_case_and_whitespace_insensitive(self):
+        outs = {run_cli(FRIDAY, "--only", t)[1] for t in ("vegan", "VEGAN", "Vegan", "  vegan ")}
+        self.assertEqual(len(outs), 1)
+        self.assertIn("Lemonade", outs.pop())
+
+    def test_only_total_is_exact_sum_with_two_decimals(self):
+        _, out, _ = run_cli(FRIDAY, "--only", "vegan")
+        last = out.splitlines()[-1].split()
+        self.assertEqual(last, ["TOTAL", "9.70"])
+        _, out, _ = run_cli("person,item,price,tags\nAda,Tea,2.5,vegan\n", "--only", "vegan")
+        self.assertEqual(out.splitlines()[1].split(), ["Ada", "Tea", "2.50"])
+        _, out, _ = run_cli("person,item,price,tags\n" + "Ada,Tea,0.10,vegan\n" * 3, "--only", "vegan")
+        self.assertEqual(out.splitlines()[-1].split(), ["TOTAL", "0.30"])
+
+    def test_only_no_match_prints_message(self):
+        code, out, err = run_cli(FRIDAY, "--only", "keto")
+        self.assertEqual((code, out, err), (0, "no items tagged keto\n", ""))
+
+    def test_only_no_match_when_order_has_no_tags(self):
+        code, out, err = run_cli("person,item,price\nAda,Tea,2.00\n", "--only", "vegan")
+        self.assertEqual((code, out, err), (0, "no items tagged vegan\n", ""))
+
+    def test_without_only_output_is_the_bill(self):
+        code, out, err = run_cli(FRIDAY)
+        self.assertEqual(code, 0)
+        self.assertEqual(err, "")
+        self.assertEqual(out.splitlines()[0].split(), ["person", "owes"])
+        self.assertTrue(out.strip().endswith("44.10"))
+
+    def test_missing_file_fails_on_stderr(self):
+        code, out, err = run_cli("", "--only", "vegan", name="nope.csv", write=False)
+        self.assertNotEqual(code, 0)
+        self.assertEqual(out, "")
+        self.assertNotIn("Traceback", err)
+        self.assertTrue(err.strip())
+
+    def test_missing_only_value_fails_on_stderr(self):
+        code, out, err = run_cli(FRIDAY, "--only")
+        self.assertNotEqual(code, 0)
+        self.assertEqual(out, "")
+        self.assertIn("--only", err)
+
+
 if __name__ == "__main__":
     unittest.main()
